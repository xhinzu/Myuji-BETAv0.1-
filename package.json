{
  "name": "myujiku-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "MyuJiku v2 — Standalone Windows desktop music player with synced word-by-word lyrics",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "tauri": "pnpm --filter desktop tauri",
    "aligner:test": "python -m pytest -c services/aligner/pytest.ini services/aligner"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
