{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyuJiku",
  "version": "2.0.0",
  "identifier": "app.myujiku.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyuJiku",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["lrc", "elrc"],
        "name": "Synced Lyrics File",
        "description": "Synchronized word-level lyrics for MyuJiku"
      },
      {
        "ext": ["mp3", "flac", "wav", "ogg", "m4a", "opus"],
        "name": "Audio Track",
        "description": "Audio file for MyuJiku"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
